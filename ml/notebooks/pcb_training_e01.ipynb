   "source": [
    "# PCB Inspector - Training E01 Baseline\n",
    "## YOLOv8n @ 640px, No Tiling, Default Augmentation\n",
    "\n",
    "**Cara pakai:**\n",
    "1. Buat Notebook baru di Kaggle\n",
    "2. Copy seluruh isi file ini ke cell\n",
    "3. Aktifkan GPU (Settings -> Accelerator -> GPU P100)\n",
    "4. Run semua cell"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================\n",
    "# 1. INSTALL DEPENDENCIES\n",
    "# ============================================\n",
    "!pip install -q ultralytics pillow pyyaml\n",
    "import os\n",
    "import sys\n",
    "import glob\n",
    "import yaml\n",
    "import shutil\n",
    "from pathlib import Path\n",
    "import xml.etree.ElementTree as ET\n",
    "\n",
    "print('Library siap.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================\n",
    "# 2. DETEKSI STRUCTURE DATASET KAGGLE\n",
    "# ============================================\n",
    "INPUT_PATH = \"/kaggle/input/pcb-defects\"\n",
    "print(f\"Dataset path: {INPUT_PATH}\")\n",
    "\n",
    "# List isi folder untuk memahami struktur\n",
    "def list_files(startpath):\n",
    "    for root, dirs, files in os.walk(startpath):\n",
    "        level = root.replace(startpath, '').count(os.sep)\n",
    "        indent = ' ' * 2 * level\n",
    "        print(f'{indent}{os.path.basename(root)}/')\n",
    "        for f in files[:5]:  # hanya tampilkan 5 file pertama per folder\n",
    "            print(f'{indent}  {f}')\n",
    "        if len(files) > 5:\n",
    "            print(f'{indent}  ... (+{len(files)-5} files)')\n",
    "\n",
    "list_files(INPUT_PATH)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================\n",
    "# 3. BUAT STRUKTUR DATASET YOLO\n",
    "# ============================================\n",
    "# Jika dataset sudah ada yang berformat YOLO, skip bagian ini.\n",
    "# Kita asumsikan dataset mungkin masih Pascal VOC dan perlu dikonversi.\n",
    "\n",
    "WORK_DIR = Path(\"/kaggle/working\")\n",
    "YOLO_DATASET = WORK_DIR / \"yolo_dataset\"\n",
    "YOLO_DATASET.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Deteksi apakah ada folder images & Annotations\n",
    "images_dir = Path(INPUT_PATH) / \"images\"\n",
    "ann_dir = Path(INPUT_PATH) / \"Annotations\"\n",
    "\n",
    "# Jika struktur tidak seperti lokal, kita cari otomatis\n",
    "if not images_dir.exists():\n",
    "    # Kemungkinan struktur lain, misal: PCB_DATASET/images, PCB_DATASET/Annotations\n",
    "    pcb_root = Path(INPUT_PATH)\n",
    "    if (pcb_root / \"PCB_DATASET\").exists():\n",
    "        pcb_root = pcb_root / \"PCB_DATASET\"\n",
    "    images_dir = pcb_root / \"images\"\n",
    "    ann_dir = pcb_root / \"Annotations\"\n",
    "\n",
    "print(f\"Images dir: {images_dir}\")\n",
    "print(f\"Annotations dir: {ann_dir}\")\n",
    "\n",
    "# Class mapping (sesuai audit)\n",
    "CLASS_MAP = {\n",
    "    \"missing_hole\": 0,\n",
    "    \"mouse_bite\": 1,\n",
    "    \"open_circuit\": 2,\n",
    "    \"short\": 3,\n",
    "    \"spur\": 4,\n",
    "    \"spurious_copper\": 5\n",
    "}\n",
    "CLASS_NAMES = list(CLASS_MAP.keys())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================\n",
    "# 4. KONVERSI PASCAL VOC -> YOLO (Jika Diperlukan)\n",
    "# ============================================\n",
    "import random\n",
    "\n",
    "# Fungsi parse XML\n",
    "def parse_xml(xml_path):\n",
    "    tree = ET.parse(xml_path)\n",
    "    root = tree.getroot()\n",
    "    size = root.find(\"size\")\n",
    "    img_w = float(size.find(\"width\").text) if size is not None and size.find(\"width\") is not None else None\n",
    "    img_h = float(size.find(\"height\").text) if size is not None and size.find(\"height\") is not None else None\n",
    "    objects = []\n",
    "    for obj in root.findall(\"object\"):\n",
    "        name = obj.find(\"name\").text.strip()\n",
    "        bbox = obj.find(\"bndbox\")\n",
    "        xmin = float(bbox.find(\"xmin\").text)\n",
    "        ymin = float(bbox.find(\"ymin\").text)\n",
    "        xmax = float(bbox.find(\"xmax\").text)\n",
    "        ymax = float(bbox.find(\"ymax\").text)\n",
    "        objects.append((name, xmin, ymin, xmax, ymax))\n",
    "    return objects, img_w, img_h\n",
    "\n",
    "# Kumpulkan semua file XML\n",
    "xml_files = list(ann_dir.rglob(\"*.xml\"))\n",
    "print(f\"Jumlah XML ditemukan: {len(xml_files)}\")\n",
    "\n",
    # Buat mapping stem -> xml path\n",
    "xml_by_stem = {xml.stem: xml for xml in xml_files}\n",
    "\n",
    "# Buat list semua gambar\n",
    "image_files = list(images_dir.rglob(\"*.jpg\")) + list(images_dir.rglob(\"*.jpeg\")) + list(images_dir.rglob(\"*.png\"))\n",
    "print(f\"Jumlah gambar ditemukan: {len(image_files)}\")\n",
    "\n",
    "# Split manual: 80% train, 20% val (tanpa test dulu, karena baseline)\n",
    "# Untuk leakage-safe, sebenarnya harus kelompok, tapi untuk E01 coba dulu\n",
    "random.seed(42)\n",
    "random.shuffle(image_files)\n",
    "\n",
    "train_ratio = 0.8\n",
    "n_train = int(len(image_files) * train_ratio)\n",
    "train_images = image_files[:n_train]\n",
    "val_images = image_files[n_train:]\n",
    "\n",
    "print(f\"Train: {len(train_images)}, Val: {len(val_images)}\")\n",
    "\n",
    "# Buat folder struktur\n",
    "for split in [\"train\", \"val\"]:\n",
    "    (YOLO_DATASET / split / \"images\").mkdir(parents=True, exist_ok=True)\n",
    "    (YOLO_DATASET / split / \"labels\").mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Proses setiap split\n",
    "all_splits = {\"train\": train_images, \"val\": val_images}\n",
    "total_boxes = 0\n",
    "\n",
    "for split_name, images in all_splits.items():\n",
    "    for img_path in images:\n",
    "        stem = img_path.stem\n",
    "        xml_path = xml_by_stem.get(stem)\n",
    "        if xml_path is None:\n",
    "            print(f\"WARNING: XML tidak ditemukan untuk {stem}\")\n",
    "            continue\n",
    "        \n",
    "        # Parse XML\n",
    "        objects, img_w, img_h = parse_xml(xml_path)\n",
    "        \n",
    "        # Tulis label file\n",
    "        label_path = YOLO_DATASET / split_name / \"labels\" / f\"{stem}.txt\"\n",
    "        with open(label_path, \"w\") as f:\n",
    "            for name, xmin, ymin, xmax, ymax in objects:\n",
    "                if name not in CLASS_MAP:\n",
    "                    continue\n",
    "                class_id = CLASS_MAP[name]\n",
    "                if img_w is None or img_h is None:\n",
    "                    from PIL import Image\n",
    "                    with Image.open(img_path) as im:\n",
    "                        img_w, img_h = im.size\n",
    "                x_center = (xmin + xmax) / 2 / img_w\n",
    "                y_center = (ymin + ymax) / 2 / img_h\n",
    "                width = (xmax - xmin) / img_w\n",
    "                height = (ymax - ymin) / img_h\n",
    "                f.write(f\"{class_id} {x_center:.6f} {y_center:.6f} {width:.6f} {height:.6f}\\n\")\n",
    "                total_boxes += 1\n",
    "        \n",
    "        # Copy gambar\n",
    "        shutil.copy2(img_path, YOLO_DATASET / split_name / \"images\" / img_path.name)\n",
    "\n",
    "print(f\"Total boxes: {total_boxes}\")\n",
    "print(f\"Dataset YOLO siap di: {YOLO_DATASET}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================\n",
    "# 5. BUAT data.yaml\n",
    "# ============================================\n",
    "data_yaml_path = YOLO_DATASET / \"data.yaml\"\n",
    "with open(data_yaml_path, \"w\") as f:\n",
    "    f.write(f\"path: {YOLO_DATASET.as_posix()}\\n\")\n",
    "    f.write(f\"train: {YOLO_DATASET.as_posix()}/train/images\\n\")\n",
    "    f.write(f\"val: {YOLO_DATASET.as_posix()}/val/images\\n\")\n",
    "    f.write(f\"nc: {len(CLASS_NAMES)}\\n\")\n",
    "    f.write(f\"names: {CLASS_NAMES}\\n\")\n",
    "\n",
    "print(f\"data.yaml: {data_yaml_path}\")\n",
    "print()\n",
    "print(Path(data_yaml_path).read_text())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================\n",
    "# 6. TRAINING BASELINE E01\n",
    "# ============================================\n",
    "from ultralytics import YOLO\n",
    "\n",
    "print(\"Loading pretrained YOLOv8n...\")\n",
    "model = YOLO(\"yolov8n.pt\")  # pretrained kecil\n",
    "\n",
    "print(\"Starting training...\")\n",
    "results = model.train(\n",
    "    data=str(data_yaml_path),\n",
    "    epochs=50,                # baseline: 50 epochs sudah cukup\n",
    "    imgsz=640,                # resolusi standar\n",
    "    batch=16,                 # batch size menyesuaikan GPU\n",
    "    device=0,                 # GPU\n",
    "    project=\"experiments/E01_baseline\",\n",
    "    name=\"yolov8n_640\",\n",
    "    exist_ok=True,\n",
    "    seed=42,\n",
    "    pretrained=True,\n",
    "    verbose=True\n",
    ")\n",
    "\n",
    "print(\"Training selesai!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================\n",
    "# 7. EVALUASI PADA VALIDATION SET\n",
    "# ============================================\n",
    "print(\"Evaluating on validation set...\")\n",
    "metrics = model.val(\n",
    "    data=str(data_yaml_path),\n",
    "    split=\"val\",\n",
    "    imgsz=640,\n",
    "    batch=16,\n",
    "    device=0\n",
    ")\n",
    "\n",
    "print(\"\\n=== METRICS E01 ===\")\n",
    "print(f\"mAP50    : {metrics.box.map50:.4f}\")\n",
    "print(f\"mAP50-95 : {metrics.box.map:.4f}\")\n",
    "print(f\"Precision: {metrics.box.mp:.4f}\")\n",
    "print(f\"Recall   : {metrics.box.mr:.4f}\")\n",
    "print(f\"F1       : {metrics.box.mf1:.4f}\")\n",
    "\n",
    "# Per-class metrics\n",
    "print(\"\\n=== Per-Class AP ===\")\n",
    "for i, name in enumerate(CLASS_NAMES):\n",
    "    print(f\"{name:<20}: AP50={metrics.box.ap50[i]:.4f}, AP50-95={metrics.box.ap[i]:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================\n",
    "# 8. SIMPAN HASIL KE /kaggle/working\n",
    "# ============================================\n",
    "import shutil\n",
    "\n",
    "# Path training hasil\n",
    "train_results = Path(\"experiments/E01_baseline/yolov8n_640\")\n",
    "print(f\"Training artifacts: {train_results.resolve()}\")\n",
    "\n",
    "# Simpan ringkasan ke JSON\n",
    "import json\n",
    "summary = {\n",
    "    \"experiment\": \"E01_baseline\",\n",
    "    \"model\": \"yolov8n\",\n",
    "    \"imgsz\": 640,\n",
    "    \"epochs\": 50,\n",
    "    \"batch\": 16,\n",
    "    \"seed\": 42,\n",
    "    \"mAP50\": metrics.box.map50,\n",
    "    \"mAP50_95\": metrics.box.map,\n",
    "    \"precision\": metrics.box.mp,\n",
    "    \"recall\": metrics.box.mr,\n",
    "    \"f1\": metrics.box.mf1,\n",
    "    \"total_boxes\": total_boxes,\n",
    "    \"dataset\": {\"train\": len(train_images), \"val\": len(val_images)}\n",
    "}\n",
    "\n",
    "with open(WORK_DIR / \"E01_summary.json\", \"w\") as f:\n",
    "    json.dump(summary, f, indent=2)\n",
    "\n",
    "print(\"Summary saved to /kaggle/working/E01_summary.json\")"
   ]
  },
